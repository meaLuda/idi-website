# Copy to .env and fill in. Never commit .env — it is gitignored and excluded
# from the Docker build context via .dockerignore.
#
# NOTE: booleans accept 1/true/yes/on (case-insensitive). The previous parser only
# accepted the literal "true", so DEBUG='1' silently meant DEBUG=False.

# --- Core -------------------------------------------------------------------
DEBUG=true
# Required whenever DEBUG is off; the app refuses to boot without it.
SECRET_KEY=
# Comma-separated. Loopback and tunnel hosts are added automatically in DEBUG.
ALLOWED_HOSTS=idi.africa,www.idi.africa
CSRF_TRUSTED_ORIGINS=https://idi.africa,https://www.idi.africa

# --- Database ---------------------------------------------------------------
# Required whenever DEBUG is off; production will not silently fall back to SQLite.
DB_NAME=ididb
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Cache / throttling -----------------------------------------------------
# Local: the shared dev-valkey container. Valkey speaks the Redis protocol.
# Use a dedicated database index and key prefix so other projects do not collide.
CACHE_URL=redis://127.0.0.1:6379/3
CACHE_KEY_PREFIX=idi

# --- Certificate verification ----------------------------------------------
# Salt for hashing visitor IPs in the scan log. Required when DEBUG is off.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Deliberately separate from SECRET_KEY so rotating one does not affect the other.
SCAN_IP_SALT=
# Proxy hops we control, counted from the right of X-Forwarded-For (Traefik = 1).
TRUSTED_PROXY_HOPS=1

# --- Email ------------------------------------------------------------------
# Local: the dev-mailpit container (SMTP 1025, web UI http://127.0.0.1:8025).
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=IDI Africa <noreply@idi.africa>
CONTACT_NOTIFICATION_EMAILS=collectives@idi.africa
ADMIN_EMAILS=

# --- Media storage (S3-compatible / Garage) --------------------------------
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=garage
AWS_S3_CUSTOM_DOMAIN=

# --- Analytics --------------------------------------------------------------
GA_MEASUREMENT_ID=

# --- Private certificate PDF archive ---------------------------------------
# MUST be a different bucket from AWS_STORAGE_BUCKET_NAME, not a prefix: the
# Garage website flag is per-bucket, and Traefik proxies the whole /media/ prefix
# publicly with a one-year immutable cache. Leave blank to store PDFs on the local
# filesystem outside MEDIA_ROOT instead.
CERT_BUCKET_NAME=
